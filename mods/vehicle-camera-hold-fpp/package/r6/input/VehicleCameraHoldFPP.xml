<?xml version="1.0"?>
<!-- Vehicle Camera Hold FPP 1.0.0: own hold action on the vehicle camera button for the
     drive, passenger and driver combat contexts (vanilla only has HoldCinematicCamera in autodrive). -->
<bindings>
    <context name="VehicleCameraHoldFPP">
        <action name="VehCamHoldFPP" map="VehicleCameraToggle" />
    </context>

    <context name="VehicleDriveBase" append="true">
        <include name="VehicleCameraHoldFPP" />
    </context>
    <context name="VehiclePassenger" append="true">
        <include name="VehicleCameraHoldFPP" />
    </context>
    <context name="VehicleOnlyForward" append="true">
        <include name="VehicleCameraHoldFPP" />
    </context>
    <context name="VehicleNoDrive" append="true">
        <include name="VehicleCameraHoldFPP" />
    </context>
    <context name="BaseVehicleDriverCombat" append="true">
        <include name="VehicleCameraHoldFPP" />
    </context>

    <hold action="VehCamHoldFPP" timeout="0.5" />
</bindings>
